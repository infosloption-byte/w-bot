generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GatewayKind {
  OFFICIAL
  WEB
}

enum MemberRole {
  OWNER
  ADMIN
  VIEWER
}

model PortalUser {
  id           String       @id @default(cuid()) @db.VarChar(191)
  email        String       @unique @db.VarChar(191)
  displayName  String       @db.VarChar(100)
  passwordHash String       @db.VarChar(255)
  createdAt    DateTime     @default(now())
  emailVerifiedAt DateTime?
  memberships  TenantMember[]
  sessions     PortalSession[]
  activations  GroupActivation[]
  accountTokens AccountToken[]
}

model Tenant {
  id          String            @id @default(cuid()) @db.VarChar(191)
  name        String            @db.VarChar(191)
  createdAt   DateTime          @default(now())
  members     TenantMember[]
  groups      Group[]
  activations GroupActivation[]
  usageBuckets TenantUsage[]
  subscription TenantSubscription?
  alertSubscription AlertSubscription?
  watchGroups WatchGroup[]
  watchRules WatchRule[]
  watchEvents WatchEvent[]
  alertMatches AlertMatch[]
  alertUsage AlertUsage[]
  auditEvents TenantAudit[]
  whatsappConnections CustomerWhatsAppConnection[]
}

model TenantMember {
  tenantId  String       @db.VarChar(191)
  userId    String       @db.VarChar(191)
  role      MemberRole   @default(OWNER)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      PortalUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime     @default(now())
  @@id([tenantId, userId])
}

model PortalSession {
  id        String      @id @default(cuid()) @db.VarChar(191)
  tokenHash String      @unique @db.Char(64)
  userId    String      @db.VarChar(191)
  user      PortalUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  @@index([userId, expiresAt])
}

model GroupActivation {
  id         String       @id @default(cuid()) @db.VarChar(191)
  codeHash   String       @unique @db.Char(64)
  tenantId   String       @db.VarChar(191)
  createdBy  String       @db.VarChar(191)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator    PortalUser   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  connectionId String? @db.VarChar(191)
  activatedGroupId String? @db.VarChar(191)
  createdAt  DateTime     @default(now())
  @@index([tenantId, expiresAt])
}

model Group {
  id              String    @id @default(cuid()) @db.VarChar(191)
  whatsappGroupId String    @db.VarChar(191)
  connectionKey   String    @default("shared") @db.VarChar(191)
  connectionId    String?   @db.VarChar(191)
  connection      CustomerWhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  tenantId        String?   @db.VarChar(191)
  claimedAt       DateTime?
  consentAt       DateTime?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name            String    @db.VarChar(191)
  enabled         Boolean   @default(true)
  gateway         GatewayKind @default(OFFICIAL)
  targetLanguages Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@index([tenantId])
  @@unique([connectionKey, whatsappGroupId])
  @@index([connectionId])
}

enum MessageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DELIVERY_UNCERTAIN
}

model Message {
  id                String        @id @default(cuid()) @db.VarChar(191)
  groupId           String        @db.VarChar(191)
  group             Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalMessageId String        @db.VarChar(191)
  senderId          String        @db.VarChar(191)
  originalText      String        @db.Text
  sourceLanguage    String?       @db.VarChar(16)
  outputText        String?       @db.Text
  outboundMessageId String?       @db.VarChar(191)
  status            MessageStatus @default(PENDING)
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now())
  lastError         String?       @db.VarChar(500)
  createdAt         DateTime      @default(now())
  processedAt       DateTime?
  sendStartedAt     DateTime?

  @@unique([groupId, externalMessageId])
  @@index([status, nextAttemptAt])
  @@index([groupId, createdAt])
}

enum AccountTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AccountToken {
  id        String           @id @default(cuid()) @db.VarChar(191)
  userId    String           @db.VarChar(191)
  user      PortalUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AccountTokenKind
  tokenHash String           @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, kind, expiresAt])
}

model TenantUsage {
  tenantId String   @db.VarChar(191)
  month    String   @db.VarChar(7)
  messages Int      @default(0)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, month])
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model TenantSubscription {
  tenantId       String  @id @db.VarChar(191)
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode       String  @default("PILOT") @db.VarChar(30)
  billingInterval BillingInterval @default(MONTHLY)
  translationEnabled Boolean @default(true)
  status         SubscriptionStatus @default(TRIAL)
  groupLimit     Int     @default(3)
  monthlyMessages Int   @default(1000)
  whatsappConnectionLimit Int @default(0) // 0 = unlimited during pilot
  periodEnd      DateTime?
  updatedAt      DateTime @updatedAt
}

model TenantAudit {
  id         String   @id @default(cuid()) @db.VarChar(191)
  tenantId   String   @db.VarChar(191)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?  @db.VarChar(191)
  groupId    String?  @db.VarChar(191)
  action     String   @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model GatewayHealth {
  name        String   @id @db.VarChar(30)
  state       String   @db.VarChar(20)
  checkedAt   DateTime @default(now())
  changedAt   DateTime @default(now())
  alertedAt   DateTime?
}

enum PlatformRole {
  SUPER_ADMIN
  VIEWER
}

model PlatformAdmin {
  id           String            @id @default(cuid()) @db.VarChar(191)
  email        String            @unique @db.VarChar(191)
  displayName  String            @db.VarChar(100)
  passwordHash String            @db.VarChar(255)
  role         PlatformRole      @default(SUPER_ADMIN)
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  lastLoginAt  DateTime?
  sessions     PlatformSession[]
  auditEntries PlatformAudit[]
}

model PlatformSession {
  id         String        @id @default(cuid()) @db.VarChar(191)
  tokenHash  String        @unique @db.Char(64)
  adminId    String        @db.VarChar(191)
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime      @default(now())

  @@index([adminId, expiresAt])
}

model PlatformAudit {
  id          String        @id @default(cuid()) @db.VarChar(191)
  adminId     String        @db.VarChar(191)
  admin       PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String        @db.VarChar(64)
  targetId    String?       @db.VarChar(191)
  createdAt   DateTime      @default(now())

  @@index([createdAt])
}

model LanguageCatalog {
  code      String   @id @db.VarChar(8)
  name      String   @db.VarChar(80)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, name])
}

enum CustomerWhatsAppKind {
  PERSONAL
  BUSINESS
}
enum CustomerWhatsAppStatus {
  CREATED
  PAIRING
  CONNECTED
  DISCONNECTED
  REQUIRES_REPAIR
  REVOKED
}

model CustomerWhatsAppConnection {
  id           String                    @id @default(cuid()) @db.VarChar(191)
  tenantId     String                    @db.VarChar(191)
  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label        String                    @db.VarChar(100)
  kind         CustomerWhatsAppKind
  status       CustomerWhatsAppStatus    @default(CREATED)
  phoneLast4   String?                   @db.Char(4)
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  lastSeenAt   DateTime?
  groups       Group[]
  watchedGroups WatchGroup[]

  @@index([tenantId, active])
}

model WhatsAppConnectionPolicy {
  id                     String   @id @default("global") @db.VarChar(20)
  personalEnabled        Boolean  @default(true)
  businessEnabled        Boolean  @default(true)
  customerNumbersEnabled Boolean  @default(false)
  maxConnectionsPerTenant Int     @default(0) // 0 = unlimited global pilot policy
  updatedAt              DateTime @updatedAt
}

/**
 * Independent Smart Alerts entitlement. Absence of a record means the feature
 * is locked. No AlertSubscription is automatically created for translators.
 * Billing checkout is not implemented; only Platform Admin can assign a pilot.
 */
model AlertSubscription {
  tenantId          String   @id @db.VarChar(191)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode          String   @default("ALERTS_PILOT") @db.VarChar(30)
  status            SubscriptionStatus @default(TRIAL)
  billingInterval   BillingInterval @default(MONTHLY)
  enabled           Boolean  @default(false)
  maxGroups         Int      @default(3)
  maxConnections    Int      @default(1)
  maxRules          Int      @default(5)
  maxMatchesPerMonth Int     @default(100)
  periodEnd         DateTime?
  updatedAt         DateTime @updatedAt
}

model WatchGroup {
  id                String   @id @default(cuid()) @db.VarChar(191)
  tenantId          String   @db.VarChar(191)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId      String   @db.VarChar(191)
  connection        CustomerWhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  whatsappGroupId   String   @db.VarChar(191)
  name              String   @db.VarChar(191)
  enabled           Boolean  @default(true)
  consentAt         DateTime
  createdAt         DateTime @default(now())
  events            WatchEvent[]

  @@unique([connectionId, whatsappGroupId])
  @@index([tenantId, enabled])
}

enum WatchEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WatchRule {
  id              String   @id @default(cuid()) @db.VarChar(191)
  tenantId        String   @db.VarChar(191)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String   @db.VarChar(100)
  category        String   @default("GENERIC") @db.VarChar(20)
  keywords        String   @db.VarChar(500)
  origin          String?  @db.VarChar(100)
  destination     String?  @db.VarChar(100)
  minPrice        Int?
  maxPrice        Int?
  requireContact  Boolean @default(false)
  enabled         Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  matches         AlertMatch[]

  @@index([tenantId, enabled])
}

model WatchEvent {
  id                String @id @default(cuid()) @db.VarChar(191)
  tenantId          String @db.VarChar(191)
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  watchGroupId      String @db.VarChar(191)
  group             WatchGroup @relation(fields: [watchGroupId], references: [id], onDelete: Cascade)
  externalMessageId String @db.VarChar(191)
  content           String? @db.Text
  status            WatchEventStatus @default(PENDING)
  attempts          Int @default(0)
  nextAttemptAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  processedAt       DateTime?
  matches           AlertMatch[]

  @@unique([watchGroupId, externalMessageId])
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

model AlertMatch {
  id                String @id @default(cuid()) @db.VarChar(191)
  tenantId          String @db.VarChar(191)
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  watchEventId      String @db.VarChar(191)
  event             WatchEvent @relation(fields: [watchEventId], references: [id], onDelete: Cascade)
  watchRuleId       String @db.VarChar(191)
  rule              WatchRule @relation(fields: [watchRuleId], references: [id], onDelete: Cascade)
  summary           String @db.VarChar(500)
  contactNumber     String? @db.VarChar(32)
  quotedPrice       Int?
  isRead            Boolean @default(false)
  createdAt         DateTime @default(now())

  @@unique([watchEventId, watchRuleId])
  @@index([tenantId, createdAt])
}

model AlertUsage {
  tenantId String @db.VarChar(191)
  month    String @db.VarChar(7)
  matches  Int @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([tenantId, month])
}
