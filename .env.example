# Copy to .env; never commit the real .env
PORT=9028
HOST=0.0.0.0
MYSQL_PASSWORD=CHANGE_TO_RANDOM_ALPHANUMERIC_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_ANOTHER_RANDOM_PASSWORD
DATABASE_URL=mysql://wbot:CHANGE_TO_RANDOM_ALPHANUMERIC_PASSWORD@localhost:3306/wbot
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN
DRY_RUN=true
# Optional unofficial linked-device gateway. Do not enable without opt-in.
WEB_GATEWAY_ENABLED=false
# Generate separately with openssl rand -hex 32
WEB_GATEWAY_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Optional alternative to QR pairing: include country code, digits only, e.g. 947XXXXXXXX
# WEB_PAIRING_PHONE_NUMBER=
TRANSLATION_PROVIDER=mock
# To use Gemini (recommended after offline tests):
# TRANSLATION_PROVIDER=gemini
# GEMINI_API_KEY=your_actual_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# Optional existing Google Cloud Translation provider:
# TRANSLATION_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=...
# Live sending requires approved Meta Groups API:
# DRY_RUN=false
# WHATSAPP_APP_SECRET=...
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_GRAPH_VERSION=v25.0

# Model B SaaS pilot (only enable after reviewing access and group consent)
SAAS_ENABLED=false
# The bot number shown on the customer dashboard, with international country code
# SAAS_BOT_NUMBER=+94XXXXXXXXX
# Generate with: openssl rand -hex 24
# SAAS_SIGNUP_CODE=YOUR_INVITE_ONLY_SIGNUP_CODE
# HTTPS in production: true. For localhost pilot over SSH port-forward: false.
SAAS_COOKIE_SECURE=true
SAAS_MAX_GROUPS=3
SAAS_MONTHLY_MESSAGES=1000

# Portal container binds to loopback only; choose a free port if needed
WBOT_PORTAL_PORT=9032
